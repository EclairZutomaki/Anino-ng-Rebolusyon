--- !u!114 &1494011797
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1494011794}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 45ed797f96dc5244f9c1f373228516e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: CRISOSTOMO
    lineText: "Maria Clara\u2026 ang tagal nating \u2019di nagkita."
    voiceClip: {fileID: 8300000, guid: f60200fc72ead5041aea73f18532ca83, type: 3}
  - speakerName: MARIA CLARA
    lineText: Ngunit sa bawat araw, hindi kita nakalimutan.
    voiceClip: {fileID: 8300000, guid: 5504b4ebdca0fce4ba19d0b3fc69b6a2, type: 3}
  - speakerName: MARIA CLARA
    lineText: Ibarra... May sasabihin ako. Si Padre Salbi...
    voiceClip: {fileID: 8300000, guid: e9e674d7fbde8a849a28bbf3f9bc4b93, type: 3}
  - speakerName: MARIA CLARA
    lineText: Hindi ko siya gusto. Palagi siyang nakatingin sa akin...
    voiceClip: {fileID: 8300000, guid: 31b86e10286fc774baac64e34ac32a36, type: 3}
  - speakerName: MARIA CLARA
    lineText: "\rParang may masamang balak. Para siyang\u2014"
    voiceClip: {fileID: 8300000, guid: b6fb1906994050247b144de484ed2370, type: 3}
  - speakerName: MARIA CLARA
    lineText: (Kilabot) Mapanghimasok.
    voiceClip: {fileID: 8300000, guid: 2e75e80c78abc574fa2cdb64f2a6061a, type: 3}
  - speakerName: CRISOSTOMO
    lineText: Kung may ginagawa siyang masama, sasabihin mo agad, ha?
    voiceClip: {fileID: 8300000, guid: 30a9ff6d05949904c8a4ec2868ec5161, type: 3}
  - speakerName: CRISOSTOMO
    lineText: 'Mag aanyaya ako para sa salusalo sa lawa.

'
    voiceClip: {fileID: 8300000, guid: 3e2720af8e276d14a99063033b599338, type: 3}
  - speakerName: CRISOSTOMO
    lineText: " Inaanyayahan ko pa rin si Padre Salvi\u2026 (huminga ng malalim)"
    voiceClip: {fileID: 8300000, guid: 8960c8cb5599a4d4ca347c13056655c5, type: 3}
  - speakerName: CRISOSTOMO
    lineText: Gusto kong makita kung anong mukha niya sa harap ng bayan.
    voiceClip: {fileID: 8300000, guid: 0fe2e03c9b206784fbacd1b72be77d95, type: 3}
  repeatable: 1
  objectsToActivate:
