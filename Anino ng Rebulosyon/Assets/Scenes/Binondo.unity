MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 919132147604128809}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 45ed797f96dc5244f9c1f373228516e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - speakerName: MANONG
    lineText: Ughhh....
    voiceClip: {fileID: 0}
  - speakerName: CRISOSTOMO
    lineText: Manong, anong nangyari?
    voiceClip: {fileID: 0}
  - speakerName: MANONG
    lineText: May sira po ang gulong ng aking kalesa Senior.
    voiceClip: {fileID: 0}
  - speakerName: MANONG
    lineText: Kailangan ko ng lupid at kahoy para maiayos ito.
    voiceClip: {fileID: 0}
  - speakerName: CRISOSTOMO
    lineText: Kung ganon, hayaan niyo na po ako maghanap sa mga iyon.
    voiceClip: {fileID: 0}
  - speakerName: MANONG
    lineText: Nako Senior hindi na po, mag papatawag nalang po ako ng karpintero.
    voiceClip: {fileID: 0}
  - speakerName: CRISOTOMO
    lineText: Hayaan niyo na po ako manong, masaya po ako nakaktulong sa iba.
    voiceClip: {fileID: 0}
  objectsToActivate:
  - {fileID: 1237184608}
  - {fileID: 40148953}
  - {fileID: 310523325}
  - {fileID: 1425183086}
  - {fileID: 1947275465}
  - {fileID: 1677463482}
  - {fileID: 1202729173}
  objectsToHide:
  - {fileID: 919132147604128809}
  activationDelay: 0.5
